  "quotes": {
   "rule": "Service providers must file their SPAC Form before any FCC Forms 472 (BEAR) or FCC Forms 474 (SPI) invoices can be processed and paid by USAC.",
   "disburse": "USAC must have a SPAC on file for the relevant funding year in order to be able to disburse funds for an FRN for that funding year.",
   "each": "FCC rules require service providers to annually submit a SPAC Form for each Service Provider Identification Number (SPIN)/498 ID for every funding year that they participate in the E-Rate program.",
   "where": "File this form in the E-Rate Productivity Center (EPC).",
   "status": "View the status of your SPAC for a particular funding year in the Service Provider (SPIN) Download Tool or the Open Data FRN Status Tool FY2016 to verify that USAC has successfully processed your SPAC form.",
   "processed": "to verify that USAC has successfully processed your SPAC form",
   "bear_what": "Applicants file an FCC Form 472 (Billed Entity Applicant Reimbursement (BEAR) Form) to request reimbursement from USAC for the discounted cost of eligible equipment and services approved on the FCC Form 471, and which the applicant has received and paid in full to its service provider.",
   "bear_after": "The FCC Form 472, or BEAR Form can be filed after:",
   "bear_spac": "The service provider has filed an FCC Form 473 (Service Provider Annual Certification (SPAC) Form) for that funding year.",
   "bear_486": "The applicant has filed an FCC Form 486",
   "bear_paid": "The applicant has paid their service provider in full for the eligible equipment and services received.",
   "uei_page": "Beginning September 8, 2026, USAC uses the System for Award Management (SAM.gov) banking information to remit payment for all Universal Service Fund (USF) invoices.",
   "uei_ann": "SPI and BEAR filers who have not completed the SAM.gov registration process and added their UEI to EPC can submit invoices but will not receive disbursements until these steps are completed.",
   "fy2026_ann": "Service provider(s) must have a FY2026 FCC Form 473 (SPAC) on file before any invoices can be processed or funding disbursed."
